# Docker Compose deployment settings. Discover both values on the VPS before
# deployment; these examples are placeholders and are not assumed defaults.
TRAEFIK_NETWORK=replace-with-existing-traefik-network
TRAEFIK_CERT_RESOLVER=replace-with-existing-certificate-resolver

# Optional public values. Next.js embeds NEXT_PUBLIC_* values at image build
# time. Leave them empty to disable the related integration.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
